{
  "name": "template-dms-demo",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && antelopejs-tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "frontend:build": "ajs dms build",
    "frontend:start": "ajs dms start",
    "frontend:verify": "ajs dms verify-source",
    "capture:start": "pnpm run build && node dist/capture-start.js",
    "lint": "oxlint && pnpm --dir frontend-vue lint",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "typecheck": "antelopejs-tsc --noEmit",
    "test": "pnpm run test:backend && pnpm --dir frontend-vue test",
    "test:backend": "pnpm run build && node --test \"dist/**/*.test.js\"",
    "knip": "knip --workspace . --dependencies",
    "knip:all": "knip --workspace .",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/core": "~1.24.5",
    "@antelopejs/interface-api": "^0.3.4",
    "@antelopejs/interface-api-util": "^0.3.3",
    "@antelopejs/interface-auth": "^0.2.2",
    "@antelopejs/interface-core": "^0.5.2",
    "@antelopejs/interface-data-api": "^0.8.2",
    "@antelopejs/interface-database": "^0.4.3",
    "@antelopejs/interface-database-decorators": "^0.5.3",
    "@antelopejs/interface-dms": "^0.14.4",
    "@antelopejs/interface-dms-automation": "^0.7.1",
    "@antelopejs/interface-dms-mailing": "^0.11.1",
    "@antelopejs/interface-dms-marketing": "^0.7.1",
    "@antelopejs/interface-dms-media": "^0.4.1",
    "@antelopejs/interface-dms-saas": "^0.10.0",
    "@openai/codex": "0.170.0"
  },
  "devDependencies": {
    "@antelopejs/dms": ">=0.21.3 <0.22.0",
    "@antelopejs/dms-frontend": "0.11.9-next.319.gdf63056",
    "@antelopejs/tooling-configs": ">=0.8.9 <0.9.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "knip": "^6.46.1",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "dmsFrontend": "dist/frontend-module.js"
}
