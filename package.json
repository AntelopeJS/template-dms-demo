{
  "name": "template-dms-demo",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "frontend:build": "ajs dms build",
    "frontend:start": "ajs dms start",
    "frontend:verify": "ajs dms verify-source",
    "capture:start": "pnpm run build && node dist/capture-start.js",
    "lint": "oxlint && pnpm --dir frontend-vue lint",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:backend && pnpm --dir frontend-vue test",
    "test:backend": "pnpm run build && node --test \"dist/**/*.test.js\"",
    "knip": "knip --workspace . --dependencies",
    "knip:all": "knip --workspace .",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync --profile template",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check --profile template",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/core": "~1.23.3",
    "@antelopejs/interface-api": "^0.3.3",
    "@antelopejs/interface-api-util": "^0.3.2",
    "@antelopejs/interface-auth": "^0.2.1",
    "@antelopejs/interface-core": "^0.5.1",
    "@antelopejs/interface-data-api": "^0.8.0",
    "@antelopejs/interface-database": "^0.4.0",
    "@antelopejs/interface-database-decorators": "^0.5.2",
    "@antelopejs/interface-dms": "^0.14.0",
    "@antelopejs/interface-dms-automation": "^0.7.0",
    "@antelopejs/interface-dms-mailing": "^0.11.0",
    "@antelopejs/interface-dms-marketing": "^0.7.0",
    "@antelopejs/interface-dms-media": "^0.4.0",
    "@antelopejs/interface-dms-saas": "^0.10.0",
    "@openai/codex": "0.166.0"
  },
  "devDependencies": {
    "@antelopejs/dms": "^0.20.0",
    "@antelopejs/dms-frontend": "^0.11.1",
    "@antelopejs/tooling-configs": "^0.7.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "knip": "^6.41.0",
    "oxfmt": "^0.77.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "dmsFrontend": "dist/frontend-module.js"
}
