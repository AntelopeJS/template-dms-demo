{
  "name": "template-dms-demo",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "frontend:build": "ajs dms build",
    "frontend:verify": "ajs dms verify-source",
    "lint": "oxlint && oxfmt --check . && pnpm --dir frontend-vue lint",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir frontend-vue test",
    "knip": "knip --workspace . --dependencies",
    "knip:all": "knip --workspace ."
  },
  "dependencies": {
    "@antelopejs/api": "file:vendor/antelopejs-api-1.3.5-af.1.tgz",
    "@antelopejs/core": "file:vendor/antelopejs-core-1.16.0-af.1.tgz",
    "@antelopejs/dms": "file:vendor/antelopejs-dms-0.9.8-af.2.tgz",
    "@antelopejs/dms-saas": "file:vendor/antelopejs-dms-saas-0.7.4-af.1.tgz",
    "@antelopejs/interface-api": "^0.0.15",
    "@antelopejs/interface-auth": "^0.0.7",
    "@antelopejs/interface-core": "^0.2.5",
    "@antelopejs/interface-data-api": "^0.2.2",
    "@antelopejs/interface-database": "^0.1.10",
    "@antelopejs/interface-database-decorators": "^0.1.9",
    "@antelopejs/interface-dms": "^0.7.4",
    "@antelopejs/interface-dms-media": "^0.3.0"
  },
  "devDependencies": {
    "@antelopejs/dms-frontend": "file:vendor/antelopejs-dms-frontend-0.7.1-af.1.tgz",
    "@antelopejs/tooling-configs": "^0.0.9",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "knip": "^6.42.1",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "@antelopejs/core": "file:vendor/antelopejs-core-1.16.0-af.1.tgz",
      "@antelopejs/api": "file:vendor/antelopejs-api-1.3.5-af.1.tgz",
      "@antelopejs/dms": "file:vendor/antelopejs-dms-0.9.8-af.2.tgz"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@antelopejs/core": "1.16.0-af.1"
      }
    }
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  }
}
