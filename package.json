{
  "name": "template-dms-demo",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "frontend:build": "ajs dms build",
    "frontend:verify": "ajs dms verify-source",
    "lint": "oxlint && oxfmt --check . && pnpm --dir frontend-vue lint",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.mts' && pnpm --dir frontend-vue test",
    "knip": "knip --workspace . --dependencies",
    "knip:all": "knip --workspace ."
  },
  "dependencies": {
    "@antelopejs/core": "1.17.0",
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-auth": ">=0.0.7 <1.0.0",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.3.0 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.10 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.9 <1.0.0",
    "@antelopejs/interface-dms": ">=0.9.0 <1.0.0",
    "@antelopejs/interface-dms-automation": ">=0.4.0 <1.0.0",
    "@antelopejs/interface-dms-mailing": ">=0.9.0 <1.0.0",
    "@antelopejs/interface-dms-marketing": ">=0.5.0 <1.0.0",
    "@antelopejs/interface-dms-media": ">=0.3.0 <1.0.0",
    "@antelopejs/interface-dms-saas": ">=0.6.0 <0.7.0"
  },
  "devDependencies": {
    "@antelopejs/dms": ">=0.10.0 <1.0.0",
    "@antelopejs/dms-frontend": "0.8.0",
    "@antelopejs/tooling-configs": "^0.0.9",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "knip": "^6.41.0",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  }
}
