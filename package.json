{
  "name": "template-cms-demo",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "ajs project run -w",
    "frontend:dev": "node --env-file=.env node_modules/@antelopejs-private/cms-nuxt/dist/index.js dev",
    "lint": "oxlint && oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt .",
    "format": "oxfmt .",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs-private/cms": "^0.6.5",
    "@antelopejs-private/cms-media": "^0.0.4",
    "@antelopejs-private/cms-nuxt": "^0.0.20",
    "@antelopejs/core": "^1.4.11",
    "@antelopejs/interface-api": "^0.0.13",
    "@antelopejs/interface-core": "^0.0.12",
    "@antelopejs/interface-data-api": "^0.1.9",
    "@antelopejs/interface-database": "^0.1.4",
    "@antelopejs/interface-database-decorators": "^0.1.6"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.0.4",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "@antelopejs-private/cms": "^0.6.5",
      "@antelopejs/interface-api": "^0.0.13"
    }
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  }
}
