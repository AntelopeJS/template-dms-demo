{
  "name": "template-dms-demo",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "frontend:build": "ajs dms build",
    "lint": "oxlint && oxfmt --check . && pnpm --dir frontend-vue lint",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir frontend-vue test",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/core": "1.9.0",
    "@antelopejs/dms-media": ">=0.0.5 <1.0.0",
    "@antelopejs/interface-api": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-core": ">=0.1.0 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.1.9 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.7 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.6 <1.0.0",
    "@antelopejs/interface-dms": ">=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/dms-frontend": "0.2.3",
    "@antelopejs/tooling-configs": ">=0.0.6 <1.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  }
}
