{
	"name": "@antelopejs/dms-ai-frontend-vue",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.6.5",
	"engines": {
		"@antelopejs/dms-frontend": ">=0.6.3 <0.8.0"
	},
	"scripts": {
		"build": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" build",
		"typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
		"typecheck:chat": "vue-tsc --noEmit -p tsconfig.chat.json",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@inertiajs/vue3": "^3.7.0",
		"@types/markdown-it": "^14.1.2",
		"dompurify": "^3.2.4",
		"markdown-it": "^14.1.0",
		"vue": "^3.5.18"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vitest/runner": "^4.1.5",
		"@vue/test-utils": "^2.4.6",
		"eslint": "^9.0.0",
		"eslint-plugin-vue": "^10.0.0",
		"globals": "^16.0.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.0.0",
		"vitest": "^4.1.5",
		"vue-tsc": "^3.1.1"
	}
}
