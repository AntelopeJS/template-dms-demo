{
  "name": "@antelopejs/dms-automation-frontend-vue",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" build",
    "typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=3",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@vue-flow/core": "^1.48.2",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@antelopejs/dms": ">=0.9.3 <1.0.0",
    "@antelopejs/dms-frontend": ">=0.6.3 <0.7.0",
    "@antelopejs/tooling-configs": ">=0.0.9 <1.0.0",
    "@eslint/js": "^9.0.0",
    "@nuxt/ui": "4.10.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.0.0",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "@antelopejs/dms-frontend": ">=0.6.3 <0.8.0"
  },
  "packageManager": "pnpm@10.6.5"
}
