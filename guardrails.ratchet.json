{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 7,
    "antelopejs/no-presence-only-type-guard": 1,
    "anti-slop/no-known-value-widening": 4,
    "anti-slop/no-unsafe-dictionary-type": 3,
    "anti-slop/require-safety-comment-for-type-assertion": 1,
    "typescript/no-unsafe-argument": 26,
    "typescript/no-unsafe-assignment": 1,
    "typescript/no-unsafe-return": 7,
    "typescript/use-unknown-in-catch-callback-variable": 1
  },
  "oversizeFiles": {}
}
