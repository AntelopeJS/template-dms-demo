# Copy this file to `.env` and adjust it. Two processes read it:
#
# - the backend (`pnpm dev`): `antelope.config.ts` loads this file with dotenv
#   and maps the variables below onto module config paths through
#   `envOverrides`;
# - the dashboard frontend (`pnpm frontend:dev`): the `ajs-dms` loader reads the
#   `.env` of the directory you run it in, which is this one.
#
# Variables that are commented out are optional locally; uncomment them when the
# matching feature or deployment needs them.

# ---------------------------------------------------------------------------
# URLs (read by both the backend and the loader)
# ---------------------------------------------------------------------------

# Backend (DMS) URL, as the frontend and generated links should reach it.
DMS_API_BASE_URL=http://localhost:5010
# Frontend URL served by `ajs-dms dev` / `ajs-dms start`.
DMS_CLIENT_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Frontend loader (`ajs-dms`)
# ---------------------------------------------------------------------------

# REQUIRED. Key encrypting the `dms_session` cookie the dashboard sets when you
# log in. Fewer than 32 characters and every login fails with
# "DMS_SESSION_SECRET must contain at least 32 characters".
# Generate one with: openssl rand -hex 32
DMS_SESSION_SECRET=replace_me_openssl_rand_hex_32_gives_a_64_character_value

# Shared secret gating the frontend manifest and module sources. `ajs-dms dev`
# does not need it (the backend publishes an ephemeral one in
# .antelope/dms-dev.json); `ajs-dms build` reads it from this variable, and the
# backend reads it as `dms.config.frontend.bootstrapSecret`.
#DMS_BOOTSTRAP_SECRET=replace_with_a_strong_random_value

# `Secure` flag on the dashboard cookies. `ajs-dms dev` defaults it to `false`
# so the cookie works over plain http://localhost; `ajs-dms start` defaults it
# to `true`. Set it to `false` only behind a terminating proxy you trust.
#DMS_COOKIE_SECURE=true

# Secret validating the `x-dms-service-token` the backend presents when it asks
# the frontend to render HTML or an email. It must equal the backend's
# `dms.config.htmlRender.serviceSecret` (default `dev`). Without it the frontend
# refuses every render request, so transactional emails fail.
#DMS_HTML_RENDER_SECRET=dev

# Secret the frontend presents as `x-dms-oauth-relay` on the backend's OAuth
# endpoints. The backend derives it from its `auth.jwtSecret`
# (HMAC-SHA256(jwtSecret, "oauth-relay"), hex) and serves it to the loader in the
# frontend manifest; set it only when you run OAuth logins with a frontend that
# cannot read that manifest.
#DMS_OAUTH_RELAY_SECRET=

# Number of trusted, rightmost reverse-proxy hops used to read `x-forwarded-*`
# (client IP, scheme, host). `0` — the default — ignores those headers entirely.
#DMS_TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# MongoDB (backend)
# ---------------------------------------------------------------------------

# Connection string and database name of the mongodb module. The values below
# are the defaults baked into antelope.config.ts; point them at a scratch
# database when you want to keep the seeded demo fixtures out of your own data.
#MONGODB_URL=mongodb://localhost:27017
#MONGODB_DATABASE=template_dms_demo

# ---------------------------------------------------------------------------
# Stripe credentials used by the dms-saas module (backend)
# ---------------------------------------------------------------------------

# The placeholders below boot fine; only the billing flows need real keys.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
